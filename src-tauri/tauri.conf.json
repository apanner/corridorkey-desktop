{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CorridorKey",
  "version": "1.0.0-dev.1",
  "identifier": "io.github.MarcelineVPQ.CorridorKeyDesktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev:ui",
    "beforeBuildCommand": "npm run build:ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CorridorKey",
        "width": 1240,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "backgroundColor": "#16181d"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
